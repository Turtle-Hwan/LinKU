# ========================================
# 개발 환경 설정 파일
# ========================================
#
# 이 파일을 복사하여 .env.development 파일을 만드세요:
#   cp .env.development.example .env.development
#
# GA4 Measurement Protocol direct 전송을 사용하려면 API secret을 설정하세요.
#
# ========================================
# Google Analytics transport
# ========================================
#
# ⚠️ 주의: .env.development 파일은 git에 올리지 마세요!
#          API secret은 direct 전송을 위해 extension bundle에 포함됩니다.
#
# ========================================

# 환경 설정 (변경하지 마세요)
VITE_ENVIRONMENT=development

# GA Measurement Protocol API secret
VITE_GA_API_SECRET=

# 우리 Backend 주소
VITE_API_BASE_URL=https://this-is-linku-backend.example/api

# VoC Google Apps Script Web App의 /exec URL
VITE_VOC_ENDPOINT=https://script.google.com/macros/s/your_deployment_id/exec

# Sentry browser DSN (Sentry Project Settings > Client Keys에서 확인)
# 비워 두면 로컬 빌드에서 Sentry 전송을 하지 않습니다.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=linku@local
# 일회성 수집 확인 때만 true로 설정하고, 확인 후 다시 false/삭제하세요.
VITE_SENTRY_SMOKE_TEST=false
