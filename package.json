{
  "name": "linku",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --mode development",
    "build": "node scripts/updateVersion.js && tsc -b && vite build --mode production && vite build --mode production-content && node scripts/checkContentScripts.js",
    "build:local": "tsc -b && vite build --mode development && vite build --mode content && node scripts/checkContentScripts.js",
    "watch": "node scripts/updateVersion.js && tsc -b && vite build --watch --mode production",
    "watch:local": "tsc -b && vite build --watch --mode development",
    "build:gh-pages": "tsc -b && vite build --mode gh-pages",
    "check:content-scripts": "node scripts/checkContentScripts.js",
    "lint": "eslint .",
    "test:timetable": "node --experimental-strip-types --test tests/timetable/*.test.ts",
    "test:feedback": "node --experimental-strip-types --test tests/feedback/*.test.ts",
    "test:ecampus": "node --experimental-strip-types --test tests/ecampus/*.test.ts",
    "test:analytics": "node --experimental-strip-types --test tests/analytics/*.test.ts",
    "test:forms": "node --experimental-strip-types --test tests/forms/*.test.ts",
    "test:monitoring": "node --experimental-strip-types --test tests/monitoring/*.test.ts",
    "test:sentry-bundle": "node scripts/verifySentryBundle.mjs",
    "test:credentials": "node --experimental-strip-types --test tests/credentials/*.test.ts",
    "test:template-share": "node --experimental-strip-types --test tests/templates/*.test.ts",
    "test:todo": "node --experimental-strip-types --test tests/todo/*.test.ts",
    "test:banner": "node --experimental-strip-types --test tests/banner/*.test.ts",
    "preview": "vite preview",
    "deploy": "git subtree push --prefix gh-pages origin gh-pages"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@sentry/browser": "^10.70.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.28.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.2",
    "react-router": "^8.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.5",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.9.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-svgr": "^5.2.0"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "^7.29.7",
      "brace-expansion": "^5.0.9",
      "js-yaml": "^4.3.1"
    }
  }
}
