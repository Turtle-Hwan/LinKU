{
  "name": "linku-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm run dev:extension",
    "dev:extension": "pnpm --filter @linku/extension dev",
    "dev:web": "pnpm --filter @linku/web dev",
    "build": "pnpm run build:web && pnpm run build:extension:validate",
    "build:web": "pnpm --filter @linku/web build",
    "build:extension": "pnpm --filter @linku/extension build",
    "build:extension:validate": "pnpm --filter @linku/extension build:validate",
    "build:extension:local": "pnpm --filter @linku/extension build:local",
    "build:local": "pnpm run build:extension:local",
    "watch": "pnpm --filter @linku/extension watch",
    "watch:local": "pnpm --filter @linku/extension watch:local",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "preview:extension": "pnpm --filter @linku/extension preview",
    "validate": "pnpm lint && pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript-eslint": "^8.57.2"
  },
  "pnpm": {
    "overrides": {
      "baseline-browser-mapping": "^2.11.7",
      "postcss": "^8.5.25",
      "rollup": "^4.59.0",
      "sharp": "^0.35.3"
    }
  }
}
