{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": { "@/*": ["../src/*"] },
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": [
    "./**/*.ts",
    "../src/types/serverless.ts",
    "../src/types/templateShare.ts",
    "../src/utils/templateShareCodec.ts"
  ]
}
